app-title = ইউএসবি ফ্ল্যাশার

# Images View
cannot-select-directories = ফাইল নির্বাচক শাখা(ডাইরেক্টরি) নির্বাচন করতে পারেনি
check-label = যাচাই
choose-image-button = ইমেজ নির্বাচন
generating-checksum = চেকসাম প্রস্তুত হচ্ছে
hash-label = হ্যাশ :
image-view-description = যে .iso বা .img ফাইল ফ্ল্যাশ করবে তা নির্বাচন করো। তোমার ইউএসবি ড্রাইভ বা পেনড্রাইভও এখন লাগাতে পারো।
image-view-title = ইমেজ নির্বাচন
no-image-selected = কোনো ইমেজ নির্বাচন করা হয়নি
none = কোনোটাই না
warning = সতর্কতা:

# Devices View
device-too-small = ডিভাইসের আকার খুব ছোট
devices-view-description = ফ্ল্যাশ করলে নির্বাচিত ড্রাইভের সব তথ্য মুছে যাবে।
devices-view-title = ড্রাইভ নির্বাচন
select-all = সব নির্বাচন

# Flashing View
flash-view-description = ফ্ল্যাশরত অবস্থায় যন্ত্র খুলবে না।
flash-view-title = ডিভাইসগুলো ফ্ল্যাশ করা হচ্ছে

# Summary View
flashing-completed = ফ্ল্যাশ করা শেষ
flash-again = আবার ফ্ল্যাশ করো

# Error View
critical-error = সঙ্কটপূর্ণ ত্রুটি হয়েছে

# Misc
cancel = বাতিল
close = বন্ধ
next = তারপর
open = খুলো
task-finished = সম্পন্ন

# Events
error = ত্রুটি : {$why}
partial-flash =  {$total} এর {$number}টি সফলভাবে ফ্ল্যাশকৃত
successful-flash = {$total}টি যন্ত্র সফলভাবে ফ্ল্যাশকৃত 
win-isos-not-supported = উইন্ডোজ এর ISO বর্তমানে সমর্থন করা হয় না

# Errors
iso-open-failed = ISO খুলতে ব্যর্থ
no-value-found = কোনো মান পাওয়া যায়নি

# Command line
question = তুমি কি আসলেই '{$image_path}' এই ড্রাইভে ইন্সটল করতে চাও?

yn = y/N 
y = y

# Arguments
arg-image = ইমেজ
arg-image-desc = ইমেজ ফাইল যোগ করো 

arg-disks = ডিস্ক
arg-disks-desc = কোন ডিস্ক যন্ত্রে ফ্ল্যাশ হবে?

arg-all-desc = খোঁজ পাওয়া সব যন্ত্রে ফ্ল্যাশ করো
arg-check-desc = লিখিত ইমেজ, উৎস ইমেজের সাথে মিলে কিনা যাচাই করো
arg-unmount-desc = যুক্ত করা যন্ত্র বের(আনমাউন্ট) করো
arg-yes-desc = নিশ্চিতকরণ ছাড়া আগাবে

# errors
error-caused-by = সমস্যার কারণ
error-image-not-set = {arg-image} নির্দিষ্ট করা হয়নি
error-image-open = '{$image_path}' এর ইমেজ খুলতে ব্যর্থ
error-image-metadata = '{$image_path}' এ অবস্থিত ইমেজ সম্পর্কিত তথ্য আনতে ব্যর্থ
error-disks-fetch = ইউএসবি ডিস্কের তালিকা পেতে ব্যর্থ
error-no-disks-specified = কোনো ডিস্ক নির্দিষ্ট করা হয়নি
error-fetching-mounts = মাউন্ট তালিকা পেতে ব্যর্থ
error-opening-disks = ডিস্ক খুলতে ব্যর্থ
error-exiting = ফ্ল্যাশ না করেই প্রস্থান করা হচ্ছে
error-reading-mounts = মাউন্ট পড়তে ত্রুটি
