{
    "app-id" : "com.system76.Popsicle",
    "runtime" : "org.freedesktop.Platform",
    "runtime-version" : "26.08",
    "base": "com.system76.Cosmic.BaseApp",
    "base-version": "stable",
    "sdk" : "org.freedesktop.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "CARGO_HOME" : "/run/build/popsicle/cargo"
        }
    },
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.UDisks2",
        "--talk-name=com.system76.CosmicSettingsDaemon",
        "--filesystem=xdg-config/cosmic:rw"
    ],
    "command" : "popsicle-ui",
    "cleanup" : [
        "/share/icons/hicolor/512x512@2x"
    ],
    "modules" : [
        {
            "name" : "popsicle",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                },
                "cargo-sources.json"
            ],
            "build-commands" : [
                "cargo build --release --manifest-path cli/Cargo.toml",
                "cargo build --release --manifest-path ui/Cargo.toml",
                "install -Dm755 target/release/popsicle /app/bin/popsicle",
                "install -Dm755 target/release/popsicle-ui /app/bin/popsicle-ui",
                "install -Dm644 ui/target/xdgen/app.desktop /app/share/applications/com.system76.Popsicle.desktop",
                "install -Dm644 ui/target/xdgen/app.metainfo.xml /app/share/metainfo/com.system76.Popsicle.appdata.xml",
                "cd resources/icons/hicolor && find . -type f -exec sh -c 'install -Dm644 \"$1\" \"/app/share/icons/hicolor/${1#./}\"' sh {} \\;"
            ]
        }
    ]
}
